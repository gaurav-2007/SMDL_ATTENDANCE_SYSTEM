      "title": "Client & Ingress Layer",
      "items": [
        "Vite React PWA serves Students, Faculty, and Admin dashboards",
        "HTML5 Geolocation & Camera APIs capture verification selfies within campus geofence",
        "Render reverse proxy terminates HTTPS and applies DDoS and security shielding"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend Services Layer",
      "items": [
        "Express 5 handles REST routes with JWT verification and role-based access guards",
        "Attendance engine dynamically calculates lecture status from division timetables",
        "Cron runner checks class transitions and scheduled alerts every 60 seconds"
      ]
    },
    {
      "dot": "violet",
      "title": "Data & Messaging Layer",
      "items": [
        "Supabase PostgreSQL stores relational timetable and attendance records with RLS",
        "Student selfies validated by image magic bytes and stored in Supabase Storage",
        "Firebase Cloud Messaging (FCM) delivers push notifications; SMTP sends OTP emails"
      ]
    }
