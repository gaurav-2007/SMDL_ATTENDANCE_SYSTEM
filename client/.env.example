# ==============================================================================
# SMDL Smart Attendance System - Client Production Environment Template (.env)
# ==============================================================================
# PUBLIC BROWSER ENVIRONMENT ONLY (Vite prefixed with VITE_)
# WARNING: NEVER put server private keys, JWT secrets, or Supabase service_role keys here!

# Production Backend API URL
# Leave as /api if frontend and backend are served from the same domain/reverse proxy.
# Set full URL (e.g., https://api.smdl.ac.in/api) if deployed on a separate domain (e.g., Vercel + Render/Railway).
VITE_API_URL=/api

# Supabase Public Anonymous Configuration
# Safe to expose to browser clients (Protected by Row Level Security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Firebase Web App Configuration (Public configuration from Firebase Console -> Project Settings -> General -> Web Apps)
# Safe to expose to browser clients
VITE_FIREBASE_API_KEY=AIzaSy...your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase Web Push VAPID Public Key (Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates)
# Safe to expose to browser clients
VITE_FIREBASE_VAPID_KEY=BKagK...your-public-vapid-key
