# ==============================================================================
# SMDL Smart Attendance System - Backend Production Environment Template (.env)
# ==============================================================================
# SECURITY NOTICE:
# - NEVER commit production credentials, service role keys, or private keys to git!
# - Ensure .env is included in .gitignore and protected with strict file permissions.

# Server Port & Mode
PORT=5000
NODE_ENV=production

# Client Application URL (Strict CORS)
# For single origin: https://attendance.smdl.ac.in
# For multiple allowed origins: comma-separated list without spaces
# Example: https://smdl-attendance.vercel.app,https://attendance.smdl.ac.in
CLIENT_URL=https://your-production-client-domain.com

# ==============================================================================
# SUPABASE POSTGRESQL & SERVICE ROLE CONFIGURATION
# ==============================================================================
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
# CRITICAL: Service role key grants administrative DB access. Protect this key!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
# Generate a cryptographically secure 256-bit secret using: openssl rand -hex 32
# DO NOT use the default 'dev_jwt_secret_change_me' in production!
JWT_SECRET=generate_strong_64_character_hex_secret_here
JWT_EXPIRES_IN=7d

# ==============================================================================
# EMAIL / SMTP CONFIGURATION (Transactional Verification & Password Resets)
# ==============================================================================
# For Google Workspace / Gmail: Use 16-character App Password (2-Step Verification -> App Passwords)
# For Dedicated SMTP (SendGrid, Brevo, AWS SES, Mailgun): Use provided SMTP credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=collegesmdl@gmail.com
SMTP_PASS=your_16_character_app_password_without_spaces
EMAIL_FROM="SMDL College Smart Attendance" <collegesmdl@gmail.com>

# ==============================================================================
# FIREBASE ADMIN SDK (SERVER-SIDE PRIVATE CREDENTIALS)
# ==============================================================================
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# Option A: Individual environment variables (Preferred for platforms like Vercel/Render/Railway)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Format: Put private key with escaped newlines \n inside double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Path to service account JSON file on server filesystem (if hosted on dedicated VM/VPS)
# FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# Optional: Public Web App Configuration mirrored on backend for /api/notifications/firebase-config endpoint
# (Public configuration only, safe to return to authenticated browser clients)
FIREBASE_WEB_API_KEY=AIzaSy...your-web-api-key
FIREBASE_WEB_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_WEB_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_WEB_APP_ID=1:123456789012:web:abcdef1234567890
FIREBASE_VAPID_KEY=BKagK...your-public-vapid-key

# ==============================================================================
# PRIVATE ATTENDANCE SELFIE STORAGE & 48-HOUR AUTOMATIC RETENTION POLICY
# ==============================================================================
ATTENDANCE_SELFIE_BUCKET=attendance-selfies
ATTENDANCE_SELFIE_RETENTION_HOURS=48

# ==============================================================================
# RATE LIMITING
# ==============================================================================
ATTENDANCE_LIMIT_WINDOW_MS=60000
ATTENDANCE_LIMIT_MAX=10
